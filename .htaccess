# Deny direct access to sensitive directories
# (<DirectoryMatch> is not allowed in .htaccess, hence mod_alias)
RedirectMatch 404 ^/(config|cache|includes|scripts|logs)(/|$)

# Do not show PHP errors in the browser
<IfModule mod_php.c>
    php_flag display_errors Off
    php_flag log_errors On
</IfModule>

# Deny access to .example files
<FilesMatch "\.example$">
    Require all denied
</FilesMatch>

# No directory listing
Options -Indexes

# Character set
AddDefaultCharset UTF-8
