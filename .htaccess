# Verweigere direkten Zugriff auf sensible Verzeichnisse
# (<DirectoryMatch> ist in .htaccess nicht erlaubt, daher mod_alias)
RedirectMatch 404 ^/(config|cache|includes|scripts|logs)(/|$)

# PHP-Fehler nicht im Browser anzeigen
<IfModule mod_php.c>
    php_flag display_errors Off
    php_flag log_errors On
</IfModule>

# Verweigere Zugriff auf .example-Dateien
<FilesMatch "\.example$">
    Require all denied
</FilesMatch>

# Kein Directory Listing
Options -Indexes

# Zeichensatz
AddDefaultCharset UTF-8
